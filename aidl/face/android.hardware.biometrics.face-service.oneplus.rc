on post-fs-data
    mkdir /data/vendor/face 0700 system system
    mkdir /data/vendor/misc 01771 system system
    mkdir /data/vendor/misc/qsee 0770 system system
    mkdir /data/vendor/misc/qsee/face 0770 system system

service vendor.face-hal /vendor/bin/hw/android.hardware.biometrics.face-service.oneplus
    class late_start
    user system
    group system camera
