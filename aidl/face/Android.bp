soong_namespace {
}

cc_binary {
    name: "android.hardware.biometrics.face-service.oneplus",
    init_rc: ["android.hardware.biometrics.face-service.oneplus.rc"],
    vintf_fragments: ["android.hardware.biometrics.face-service.oneplus.xml"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "AuthEngine.cpp",
        "AuthTee.cpp",
        "CameraSource.cpp",
        "Face.cpp",
        "FaceEngine.cpp",
        "FaceTee.cpp",
        "Session.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.biometrics.common-V4-ndk",
        "android.hardware.biometrics.face-V4-ndk",
        "android.hardware.common-V2-ndk",
        "android.hardware.keymaster-V4-ndk",
        "libbase",
        "libbinder_ndk",
        "libcamera2ndk_vendor",
        "libdl",
        "libion",
        "liblog",
        "libmediandk",
        "libnativewindow",
        "libziparchive",
    ],
    static_libs: [
        "android.hardware.biometrics.common.thread",
        "android.hardware.biometrics.common.util",
    ],
}
