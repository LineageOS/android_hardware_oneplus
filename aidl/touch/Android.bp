filegroup {
    name: "vendor.lineage.touch-oneplus-touchgesture",
    srcs: ["TouchscreenGesture.cpp"],
}

cc_library_headers {
    name: "vendor.lineage.touch-oneplus-headers",
    vendor_available: true,
    export_include_dirs: ["."],
}

cc_binary {
    name: "vendor.lineage.touch-service.oneplus",
    init_rc: ["vendor.lineage.touch-service.oneplus.rc"],
    vintf_fragments: ["vendor.lineage.touch-service.oneplus.xml"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        ":vendor.lineage.touch-oneplus-touchgesture",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libbinder_ndk",
        "libutils",
        "vendor.lineage.touch-V1-ndk",
    ],
    header_libs: [
        "vendor.lineage.touch-oneplus-headers",
    ],
    include_dirs: select(soong_config_variable("ONEPLUS_LINEAGE_TOUCH_HAL", "INCLUDE_DIR"), {
        any @ flag_val: [flag_val],
        default: [],
    }),
}
